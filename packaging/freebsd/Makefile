# FreeBSD port skeleton for mcwsd.
#
# This is a starting point for sysutils/mcwsd, not a submitted port: review
# against the Porter's Handbook (https://docs.freebsd.org/en/books/porters-handbook/)
# and run `portlint -AC` before submitting to bugzilla.
#
#   cd /usr/ports/sysutils && cp -R /path/to/mcwsd/packaging/freebsd mcwsd
#   cd mcwsd && make makesum && make stage && make check-plist
#
# distinfo is generated by `make makesum` (Go modules only: no distfiles).

PORTNAME=	mcwsd
DISTVERSIONPREFIX=	v
DISTVERSION=	0.5.6
CATEGORIES=	sysutils

MAINTAINER=	azcrumpty@msn.com
COMMENT=	Workspace daemon for ephemeral coding-agent development environments
WWW=		https://github.com/davidcrumpton/mcwsd

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

USES=		go:modules
USE_RC_SUBR=	mcwsd

GO_MODULE=	github.com/davidcrumpton/mcwsd
GO_BUILDFLAGS=	-trimpath
GO_LDFLAGS=	-s -w -X main.Version=${DISTVERSION}

SUB_FILES=	pkg-message
SUB_LIST=	MCWSD_DATADIR=${PREFIX}/share/mcwsd

USERS=		_wsd
GROUPS=		_wsd

post-patch:
	@${REINPLACE_CMD} -e 's|/usr/share/mcwsd/plugins|${PREFIX}/share/mcwsd/plugins|g' \
		${WRKSRC}/packaging/systemd/mcwsd.service

do-install:
	${INSTALL_PROGRAM} ${WRKDIR}/bin/mcwsd ${STAGEDIR}${PREFIX}/bin/mcwsd
	@${MKDIR} ${STAGEDIR}${PREFIX}/share/mcwsd/plugins
	${INSTALL_DATA} ${WRKSRC}/plugins/*.js ${STAGEDIR}${PREFIX}/share/mcwsd/plugins
	@${MKDIR} ${STAGEDIR}${DOCSDIR}
	${INSTALL_DATA} ${WRKSRC}/README.md ${STAGEDIR}${DOCSDIR}/README.md
	${INSTALL_DATA} ${WRKSRC}/PLUGINS.md ${STAGEDIR}${DOCSDIR}/PLUGINS.md
	${INSTALL_DATA} ${WRKSRC}/FREEBSD-SETUP.md ${STAGEDIR}${DOCSDIR}/FREEBSD-SETUP.md

.include <bsd.port.mk>
