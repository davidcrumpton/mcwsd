# /etc/mcwsd/mcwsd.env
#
# Read by mcwsd.service (EnvironmentFile=-/etc/mcwsd/mcwsd.env).
# Mode 0640 root:_wsd so the daemon can read it but not modify it.
#
# The daemon refuses to start without a client token unless
# --workspace-auth-mode is satisfied, so set MCWSD_TOKEN first.
# Generate one with:  mcwsd token
#
#MCWSD_TOKEN=wsd-replace-me

# --- Forge credentials (optional; needed for commit_and_pr) -----------------
# Pick the forge with --forge-type=gitlab|github|gitea|forgejo in the unit.
#MCWSD_GITHUB_TOKEN=ghp_replace_me
#MCWSD_GITLAB_TOKEN=glpat-replace_me
#MCWSD_GITEA_TOKEN=
#MCWSD_FORGEJO_TOKEN=

# --- Git authentication over SSH -------------------------------------------
#MCWSD_GIT_AUTH_MODE=ssh
#MCWSD_GIT_SSH_KEY_PATH=/etc/mcwsd/ssh/id_ed25519
#MCWSD_GIT_SSH_KNOWN_HOSTS=/etc/mcwsd/ssh/known_hosts

# --- TLS -------------------------------------------------------------------
# TLS is configured with flags, not environment variables: add
#   --tls-cert-file /etc/mcwsd/tls/fullchain.pem
#   --tls-key-file  /etc/mcwsd/tls/key.pem
# to the ExecStart line in /usr/lib/systemd/system/mcwsd.service
# (or drop a copy in /etc/systemd/system/mcwsd.service.d/).
